# Usuários permitidos em qualquer plataforma, no formato plataforma:id (opcional)
ALLOWED_USERS="telegram:123456789"
# Sua chave de API OpenAI (opcional)
OPENAI_API_KEY="PUT_YOUR_OPENAI_KEY_HERE"
# Sua chave de API da Anthropic (opcional)
ANTHROPIC_API_KEY="PUT_YOUR_ANTHROPIC_KEY_HERE"
# Sua chave de API do Gemini (opcional)
GEMINI_API_KEY="PUT_YOUR_GOOGLE_AI_STUDIO_KEY_HERE"
# O modelo que será usado para gerar as respostas, Google AI Studio (opcional)
GEMINI_MODEL="gemini-3.6-flash"
# O modelo que será usado para gerar as respostas, OpenAI (opcional)
OPENAI_MODEL="gpt-5.6-luna"
# O modelo que será usado para gerar as respostas, Anthropic (opcional)
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
# A plataforma de chat que será usada: telegram (opcional)
CHAT_PROVIDER="telegram"
# O token do bot do Telegram, obtido com o @BotFather (obrigatório se CHAT_PROVIDER=telegram)
TELEGRAM_BOT_TOKEN="PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE"
# A timezone que será usada em datas e horários (opcional)
TIMEZONE="America/Sao_Paulo"
# O nível de logging que o app irá usar (opcional)
LOG_LEVEL="debug"
# O ID da planilha do Google onde os gastos são salvos, o trecho entre /d/ e /edit na URL. Sem ele, os gastos ficam só em memória (opcional)
SPREADSHEET_ID="PUT_YOUR_SPREADSHEET_ID_HERE"
# O caminho do JSON da chave da service account do Google (obrigatório se SPREADSHEET_ID estiver definido, a não ser que GOOGLE_SERVICE_ACCOUNT_JSON seja usado)
GOOGLE_APPLICATION_CREDENTIALS="./google-service-account.json"
# O conteúdo do JSON da chave da service account, puro ou em base64. Útil em plataformas de container, onde não há arquivo (opcional, tem prioridade sobre o caminho)
GOOGLE_SERVICE_ACCOUNT_JSON=""